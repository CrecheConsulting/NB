<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NBEduca Recruitment | Top-Tier Spanish Educators for Irish Schools</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; scroll-behavior: smooth; }
        .hero-gradient { background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); }
        .pricing-card:hover { transform: translateY(-5px); transition: all 0.3s ease; }
        .success-step::after { content: ''; position: absolute; top: 50%; right: -50%; width: 100%; height: 2px; background: #e5e7eb; z-index: -1; }
        @media (max-width: 768px) { .success-step::after { display: none; } }
    </style>
</head>
<body class="bg-slate-50 text-slate-900">

    <!-- Navigation -->
    <nav class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="bg-blue-600 text-white p-2 rounded-lg font-bold text-xl">NB</div>
                <span class="font-bold text-xl tracking-tight text-blue-900">Educa Recruitment</span>
            </div>
            <div class="hidden md:flex gap-8 font-medium text-slate-600">
                <a href="#process" class="hover:text-blue-600">Our Process</a>
                <a href="#pricing" class="hover:text-blue-600">Pricing</a>
                <a href="#why-us" class="hover:text-blue-600">Why Us</a>
            </div>
            <a href="#contact" class="bg-blue-600 text-white px-5 py-2 rounded-full font-semibold hover:bg-blue-700 transition">Get Started</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="hero-gradient text-white py-20 px-4">
        <div class="max-w-7xl mx-auto text-center">
            <span class="bg-blue-400/30 text-blue-100 px-4 py-1 rounded-full text-sm font-semibold mb-6 inline-block uppercase tracking-wider">Zero Upfront Cost</span>
            <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-tight">Elite Spanish Educators for <br><span class="text-blue-200">Irish Early Years Centers</span></h1>
            <p class="text-xl text-blue-100 mb-10 max-w-2xl mx-auto">We solve your staffing crisis by providing highly-qualified Level 7 & 8 Spanish teachers. No payment until they are successfully working in your school.</p>
            <div class="flex flex-col md:flex-row justify-center gap-4">
                <a href="#pricing" class="bg-white text-blue-700 px-8 py-4 rounded-xl font-bold text-lg shadow-lg hover:bg-blue-50 transition">View Plans & Pricing</a>
                <a href="#process" class="bg-blue-500 text-white border border-blue-400 px-8 py-4 rounded-xl font-bold text-lg hover:bg-blue-400 transition">How it Works</a>
            </div>
        </div>
    </header>

    <!-- Trust Bar -->
    <section class="py-12 bg-white border-b">
        <div class="max-w-7xl mx-auto px-4 flex flex-wrap justify-around items-center gap-8 opacity-70">
            <div class="flex items-center gap-2 font-semibold"><i class="fas fa-check-circle text-green-500"></i> Tusla Compliant</div>
            <div class="flex items-center gap-2 font-semibold"><i class="fas fa-graduation-cap text-blue-500"></i> Level 7/8 Specialists</div>
            <div class="flex items-center gap-2 font-semibold"><i class="fas fa-shield-alt text-purple-500"></i> Recruitment Guarantee</div>
            <div class="flex items-center gap-2 font-semibold"><i class="fas fa-home text-orange-500"></i> Housing Managed</div>
        </div>
    </section>

    <!-- The Problem / Solution -->
    <section id="why-us" class="py-20 px-4 max-w-7xl mx-auto">
        <div class="grid md:grid-cols-2 gap-16 items-center">
            <div>
                <h2 class="text-3xl font-bold mb-6 text-slate-800">Why schools choose NBEduca</h2>
                <p class="text-lg text-slate-600 mb-8 text-balance">Staffing turnover and the housing crisis shouldn't stop your school from growing. We provide a bridge to motivated, qualified professionals from Spain who are ready for a long-term project in Ireland.</p>
                
                <ul class="space-y-4">
                    <li class="flex gap-4">
                        <div class="bg-blue-100 p-3 rounded-full h-12 w-12 flex items-center justify-center text-blue-600 shrink-0">
                            <i class="fas fa-euro-sign"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-slate-800">Maximize Capitation Grants</h4>
                            <p class="text-slate-600">We prioritize Level 8 candidates, helping you access higher government subsidies from day one.</p>
                        </div>
                    </li>
                    <li class="flex gap-4">
                        <div class="bg-orange-100 p-3 rounded-full h-12 w-12 flex items-center justify-center text-orange-600 shrink-0">
                            <i class="fas fa-key"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-slate-800">Housing Solved</h4>
                            <p class="text-slate-600">Our network of landlords ensures your new teacher has a place to live, preventing last-minute dropouts.</p>
                        </div>
                    </li>
                    <li class="flex gap-4">
                        <div class="bg-green-100 p-3 rounded-full h-12 w-12 flex items-center justify-center text-green-600 shrink-0">
                            <i class="fas fa-user-check"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-slate-800">Full Bureaucracy Support</h4>
                            <p class="text-slate-600">From PPS Numbers to certified translations. We handle the paperwork so you can focus on the children.</p>
                        </div>
                    </li>
                </ul>
            </div>
            <div class="bg-blue-50 rounded-3xl p-8 border border-blue-100 shadow-inner">
                <div class="text-center mb-8">
                    <h3 class="text-2xl font-bold text-blue-900">The "Success-First" Model</h3>
                    <p class="text-blue-700">We only win when you win.</p>
                </div>
                <div class="space-y-8 relative">
                    <div class="flex items-center gap-6">
                        <div class="bg-white w-12 h-12 rounded-full flex items-center justify-center font-bold text-blue-600 shadow border border-blue-100 z-10">1</div>
                        <p class="font-semibold text-slate-700">We find & vet your ideal candidate for FREE.</p>
                    </div>
                    <div class="flex items-center gap-6">
                        <div class="bg-white w-12 h-12 rounded-full flex items-center justify-center font-bold text-blue-600 shadow border border-blue-100 z-10">2</div>
                        <p class="font-semibold text-slate-700 text-blue-600 font-bold">The teacher starts working. (1st Payment)</p>
                    </div>
                    <div class="flex items-center gap-6">
                        <div class="bg-white w-12 h-12 rounded-full flex items-center justify-center font-bold text-blue-600 shadow border border-blue-100 z-10">3</div>
                        <p class="font-semibold text-slate-700">Teacher is still there after 6 months. (2nd Payment)</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Pricing Section -->
    <section id="pricing" class="py-20 bg-slate-100 px-4">
        <div class="max-w-7xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-4xl font-bold mb-4">Transparent Pricing Plans</h2>
                <p class="text-slate-600 text-lg">No hidden fees. Split payments for your peace of mind.</p>
            </div>

            <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
                <!-- Base Plan -->
                <div class="bg-white rounded-3xl shadow-xl overflow-hidden pricing-card border border-slate-200">
                    <div class="p-8">
                        <h3 class="text-xl font-bold text-slate-800 mb-2 uppercase tracking-wide">Base Plan</h3>
                        <div class="flex items-baseline gap-1 mb-6">
                            <span class="text-4xl font-bold text-slate-900">€375</span>
                            <span class="text-slate-500 font-medium">/ per payment</span>
                        </div>
                        <p class="text-slate-600 mb-8">Essential recruitment for schools with internal capacity for housing and technical interviews.</p>
                        
                        <ul class="space-y-4 mb-8">
                            <li class="flex items-center gap-3"><i class="fas fa-check text-blue-500"></i> Qualified Candidate Search</li>
                            <li class="flex items-center gap-3"><i class="fas fa-check text-blue-500"></i> English Level Assessment (B1+)</li>
                            <li class="flex items-center gap-3"><i class="fas fa-check text-blue-500"></i> Degree Verification (Level 6/8)</li>
                            <li class="flex items-center gap-3"><i class="fas fa-check text-blue-500"></i> Certified Translations Management</li>
                            <li class="flex items-center gap-3"><i class="fas fa-check text-blue-500"></i> PPS Number Support</li>
                            <li class="flex items-center gap-3 text-slate-400"><i class="fas fa-times"></i> Housing Support</li>
                        </ul>
                    </div>
                    <div class="bg-slate-50 p-6 border-t">
                        <div class="flex justify-between items-center text-sm font-bold text-slate-700">
                            <span>Total Investment:</span>
                            <span>€750</span>
                        </div>
                        <p class="text-[10px] text-slate-400 mt-2 italic">*Paid in two stages: Start Date & 6th Month Anniversary.</p>
                    </div>
                </div>

                <!-- Premium Plan -->
                <div class="bg-white rounded-3xl shadow-2xl overflow-hidden pricing-card border-2 border-blue-500 relative">
                    <div class="absolute top-0 right-0 bg-blue-500 text-white px-6 py-1 font-bold text-sm uppercase rounded-bl-xl tracking-widest">Recommended</div>
                    <div class="p-8">
                        <h3 class="text-xl font-bold text-blue-900 mb-2 uppercase tracking-wide">Premium Pack</h3>
                        <div class="flex items-baseline gap-1 mb-6 text-blue-600">
                            <span class="text-4xl font-bold">€500</span>
                            <span class="font-medium">/ per payment</span>
                        </div>
                        <p class="text-slate-600 mb-8">The total solution. We handle everything from housing to technical screening and risk protection.</p>
                        
                        <ul class="space-y-4 mb-8">
                            <li class="flex items-center gap-3"><i class="fas fa-check-double text-blue-500"></i> All Base Plan Services</li>
                            <li class="flex items-center gap-3 font-semibold"><i class="fas fa-home text-orange-500"></i> Guaranteed Housing Support</li>
                            <li class="flex items-center gap-3 font-semibold"><i class="fas fa-phone-alt text-blue-500"></i> Full Reference Validation</li>
                            <li class="flex items-center gap-3 font-semibold"><i class="fas fa-video text-blue-500"></i> NBEduca Technical Interview</li>
                            <li class="flex items-center gap-3 font-semibold text-green-600"><i class="fas fa-shield-heart"></i> 2-Month Replacement Guarantee</li>
                        </ul>
                    </div>
                    <div class="bg-blue-50 p-6 border-t border-blue-100">
                        <div class="flex justify-between items-center text-sm font-bold text-blue-900">
                            <span>Total Investment:</span>
                            <span>€1,000</span>
                        </div>
                        <p class="text-[10px] text-blue-500 mt-2 italic">*Includes all-inclusive logistics and risk coverage.</p>
                    </div>
                </div>
            </div>

            <!-- Optional Services -->
            <div class="mt-20 max-w-4xl mx-auto">
                <h3 class="text-2xl font-bold mb-8 text-center">Add-on Services</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="bg-white p-4 rounded-xl border flex flex-col items-center text-center shadow-sm">
                        <i class="fas fa-home text-orange-400 mb-2 text-xl"></i>
                        <h4 class="font-bold text-sm">Housing Support</h4>
                        <p class="text-lg font-bold text-blue-600">+€50 <span class="text-xs text-slate-400">/payment</span></p>
                    </div>
                    <div class="bg-white p-4 rounded-xl border flex flex-col items-center text-center shadow-sm">
                        <i class="fas fa-phone-square text-blue-400 mb-2 text-xl"></i>
                        <h4 class="font-bold text-sm">Reference Check</h4>
                        <p class="text-lg font-bold text-blue-600">+€30 <span class="text-xs text-slate-400">/payment</span></p>
                    </div>
                    <div class="bg-white p-4 rounded-xl border flex flex-col items-center text-center shadow-sm">
                        <i class="fas fa-microphone text-purple-400 mb-2 text-xl"></i>
                        <h4 class="font-bold text-sm">Pro Interview</h4>
                        <p class="text-lg font-bold text-blue-600">+€40 <span class="text-xs text-slate-400">/payment</span></p>
                    </div>
                    <div class="bg-white p-4 rounded-xl border flex flex-col items-center text-center shadow-sm">
                        <i class="fas fa-undo text-green-400 mb-2 text-xl"></i>
                        <h4 class="font-bold text-sm">2-Mo Guarantee</h4>
                        <p class="text-lg font-bold text-blue-600">+€30 <span class="text-xs text-slate-400">/payment</span></p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ / Final CTA -->
    <section id="contact" class="py-20 px-4 bg-blue-900 text-white overflow-hidden relative">
        <div class="max-w-4xl mx-auto text-center relative z-10">
            <h2 class="text-3xl md:text-5xl font-bold mb-8 italic">"The right teacher doesn't just fill a spot, they elevate the entire school."</h2>
            <p class="text-xl text-blue-200 mb-12">Ready to secure your next Level 8 educator with zero risk?</p>
            
            <form class="bg-white p-8 rounded-3xl text-slate-800 shadow-2xl text-left grid md:grid-cols-2 gap-6">
                <div class="col-span-2">
                    <h3 class="text-2xl font-bold text-blue-900 mb-4">Request Your Candidate</h3>
                </div>
                <div>
                    <label class="block text-sm font-bold mb-2">School Name</label>
                    <input type="text" placeholder="e.g. Dublin Little Stars" class="w-full p-3 rounded-xl border border-slate-200 focus:outline-blue-500">
                </div>
                <div>
                    <label class="block text-sm font-bold mb-2">Your Email</label>
                    <input type="email" placeholder="director@school.ie" class="w-full p-3 rounded-xl border border-slate-200 focus:outline-blue-500">
                </div>
                <div class="col-span-2">
                    <label class="block text-sm font-bold mb-2">Staffing Needs</label>
                    <textarea placeholder="Tell us how many Level 7/8 teachers you need..." class="w-full p-3 rounded-xl border border-slate-200 h-32 focus:outline-blue-500"></textarea>
                </div>
                <button type="submit" class="col-span-2 bg-blue-600 text-white font-bold py-4 rounded-xl hover:bg-blue-700 transition text-lg">Send Inquiry & Start Search</button>
            </form>
        </div>
        <!-- Decorative blobs -->
        <div class="absolute -bottom-20 -left-20 w-80 h-80 bg-blue-600 rounded-full blur-3xl opacity-20"></div>
        <div class="absolute -top-20 -right-20 w-80 h-80 bg-blue-400 rounded-full blur-3xl opacity-20"></div>
    </section>

    <footer class="bg-slate-900 text-slate-400 py-10 px-4 border-t border-slate-800">
        <div class="max-w-7xl mx-auto flex flex-col md:row justify-between items-center gap-6">
            <div class="flex items-center gap-2">
                <div class="bg-slate-700 text-white p-1 rounded font-bold">NB</div>
                <span class="font-bold text-white tracking-tight">Educa Recruitment</span>
            </div>
            <p class="text-sm">© 2024 NBEduca Recruitment. Connecting Spanish Excellence with Irish Education.</p>
            <div class="flex gap-4">
                <a href="#" class="hover:text-white"><i class="fab fa-linkedin text-xl"></i></a>
                <a href="#" class="hover:text-white"><i class="fab fa-whatsapp text-xl"></i></a>
            </div>
        </div>
    </footer>

</body>
</html>
